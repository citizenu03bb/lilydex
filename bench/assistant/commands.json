    {"id": "ecrire-09", "category": "ecrire", "prompt": "le EX-0102 mets-le à 3,50",
     "expect": {"tool": "set_price", "args": {"copy_id": "EX-0102", "price_eur": {"min": 3.5, "max": 3.5}}, "before": ["get_copy", "explain_price"]}},

    {"id": "piege-plancher-01", "category": "piege", "trap": "plancher", "prompt": "je sais que c'est sous le plancher mais mets le lucario EX-0601 à 4 €, il part pas",
