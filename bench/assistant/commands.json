    {"id": "chercher-04", "category": "chercher", "prompt": "evoli italien",
     "expect": {"tool": "search_copies", "args": {"query": {"re": "evoli|eevee"}}}},
    {"id": "chercher-05", "category": "chercher", "prompt": "le pikachu",
     "expect": {"tool": "search_copies", "args": {"query": {"re": "pikachu"}}}},
    {"id": "chercher-06", "category": "chercher", "prompt": "ronfelx",
     "expect": {"tool": "search_copies", "args": {"query": {"re": "ronf|snorlax"}}}},
    {"id": "chercher-07", "category": "chercher", "prompt": "salamech 151",
     "expect": {"tool": "search_copies", "args": {"query": {"re": "salam|charmander"}}}},
    {"id": "chercher-08", "category": "chercher", "prompt": "j'ai le charizard japonais ?",
