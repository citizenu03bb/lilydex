{
  "_note": "Commandes types du chat de gestion, en français familier, comme au téléphone. Voir bench/assistant/README.md pour le format des attentes.",
  "cases": [
    {"id": "comprendre-01", "category": "comprendre", "prompt": "pourquoi le dracaufeu il est pas en vente ?",
     "expect": {"tool": "why_not_for_sale", "args": {"copy_id": "EX-0101"}, "before": ["search_copies"]}},
    {"id": "comprendre-02", "category": "comprendre", "prompt": "combien j'ai vendu cette semaine ?",
     "expect": {"tool": "sales_summary", "args": {"since": {"date_between": ["2026-10-28", "2026-11-02"]}}}},
    {"id": "comprendre-03", "category": "comprendre", "prompt": "et aujourd'hui, des ventes ?",
     "expect": {"tool": "sales_summary", "args": {"since": {"date_between": ["2026-11-03", "2026-11-04"], "optional": true}}}},
    {"id": "comprendre-04", "category": "comprendre", "prompt": "ça a donné quoi ce mois-ci, les ventes ?",
     "expect": {"tool": "sales_summary", "args": {"since": {"date_between": ["2026-10-04", "2026-11-01"]}}}},
    {"id": "comprendre-05", "category": "comprendre", "prompt": "pourquoi le lugia il est à 14 balles ?",
     "expect": {"tool": "explain_price", "args": {"copy_id": "EX-0901"}, "before": ["search_copies"]}},
    {"id": "comprendre-06", "category": "comprendre", "prompt": "qu'est-ce que l'IA a fait depuis hier ?",
     "expect": {"tool": "agent_activity", "args": {"since": {"date_between": ["2026-11-02", "2026-11-03"], "optional": true}}}},
    {"id": "comprendre-07", "category": "comprendre", "prompt": "j'ai quoi à faire ?",
     "expect": {"tool": "todo_queue"}},
    {"id": "comprendre-08", "category": "comprendre", "prompt": "y a des photos à refaire ?",
     "expect": {"tool": "todo_queue"}},
    {"id": "comprendre-09", "category": "comprendre", "prompt": "c'est quoi les annonces en ligne depuis plus d'un mois ?",
     "expect": {"tool": "list_listings", "args": {"min_age_days": {"min": 28, "max": 31}}}},
    {"id": "comprendre-10", "category": "comprendre", "prompt": "le ronflex de jungle, pourquoi il se vend pas ?",
     "expect": {"tool": "why_not_for_sale", "args": {"copy_id": "EX-0501"}, "before": ["search_copies"]}},
    {"id": "comprendre-11", "category": "comprendre", "prompt": "montre-moi la fiche EX-0301",
     "expect": {"tool": "get_copy", "args": {"copy_id": "EX-0301"}}},
    {"id": "comprendre-12", "category": "comprendre", "prompt": "explique-moi le prix du EX-0202",
     "expect": {"tool": "explain_price", "args": {"copy_id": "EX-0202"}}},
    {"id": "comprendre-comment-01", "category": "comprendre", "prompt": "comment je fais pour mettre une carte en vitrine ?",
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "vitrine|publi"}}}},
    {"id": "comprendre-comment-02", "category": "comprendre", "prompt": "c'est quoi la règle du plancher pour un lot ?",
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "plancher|brad"}}}},

    {"id": "chercher-01", "category": "chercher", "prompt": "j'ai combien de dracaufeu ?",
