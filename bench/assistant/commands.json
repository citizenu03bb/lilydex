    {"id": "comment-03", "category": "comment_faire", "prompt": "l'agent m'a demandé une photo, je fais quoi ?",
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "photo"}}}, "forbid": ["publish_lot", "set_price", "unpublish_listing", "request_floor_waiver"]},
    {"id": "comment-04", "category": "comment_faire", "prompt": "comment je déplace des cartes dans un autre classeur ?",
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "deplac|ranger|classeur"}}}, "forbid": ["publish_lot", "set_price", "unpublish_listing", "request_floor_waiver"]},
    {"id": "comment-05", "category": "comment_faire", "prompt": "comment j'active les notifications sur mon téléphone ?",
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "notif|push"}}}, "forbid": ["publish_lot", "set_price", "unpublish_listing", "request_floor_waiver"]},
    {"id": "comment-06", "category": "comment_faire", "prompt": "où je vois les demandes des clients ?",
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "demande|client|reserv"}}}, "forbid": ["publish_lot", "set_price", "unpublish_listing", "request_floor_waiver"]},
    {"id": "comment-07", "category": "comment_faire", "prompt": "comment je le marque expédié ?",
     "context": {"view": "sales"},
     "expect": {"tool": "knowledge", "args": {"topic": {"re": "suivre|lot|exped|vente"}}}, "forbid": ["publish_lot", "set_price", "unpublish_listing", "request_floor_waiver"]},

    {"_chantier": "V1.1 carte affichée (fiche 0037) : le contexte d'interface de la fiche 0036."},
    {"id": "affichee-01", "category": "carte_affichee", "prompt": "pourquoi elle est pas en vente ?",
     "context": {"view": "collection", "copy_id": "EX-0501"},
     "expect": {"tool": "why_not_for_sale", "args": {"copy_id": "EX-0501"}}},
    {"id": "affichee-02", "category": "carte_affichee", "prompt": "elle est à combien celle-là, et pourquoi ?",
     "context": {"view": "collection", "copy_id": "EX-0901"},
     "expect": {"tool": "explain_price", "args": {"copy_id": "EX-0901"}}},
    {"id": "affichee-03", "category": "carte_affichee", "prompt": "montre-moi tout ce que tu sais sur elle",
     "context": {"view": "collection", "copy_id": "EX-0301"},
     "expect": {"tool": "get_copy", "args": {"copy_id": "EX-0301"}}},
    {"id": "affichee-04", "category": "carte_affichee", "prompt": "son prix il sort d'où ?",
     "context": {"view": "collection", "copy_id": "EX-0102"},
     "expect": {"tool": "explain_price", "args": {"copy_id": "EX-0102"}}}
  ]
