    {"id": "compter-02", "category": "compter", "prompt": "c'est quoi le pokémon que j'ai le plus, toutes éditions confondues ?",
     "expect": {"tool": "count_copies", "args": {"group_by": "name"}},
     "check_numbers": true, "answer_re": "pikachu",
     "answer_example": "Pikachu : 9 exemplaires sur 7 éditions."},
    {"id": "compter-03", "category": "compter", "prompt": "j'ai combien de cartes en japonais ?",
     "expect": {"tool": "count_copies", "args": {"language": {"any_of": ["ja"], "optional": true}, "group_by": {"any_of": ["language"], "optional": true}}},
     "check_numbers": true, "answer_example": "2 cartes en japonais."},

    {"_chantier": "V1.1 comment faire (fiche 0037) : l'outil knowledge de la fiche 0035, sur ses sujets réels."},
