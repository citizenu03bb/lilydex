[Unit]
Description=Brief du jour de la gestion (notification)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pokeprice
Group=pokeprice
WorkingDirectory=/opt/pokeprice
Environment=HOME=/srv/pokeprice
Environment=XDG_CONFIG_HOME=/srv/pokeprice/.config
# The notification channels (ntfy, e-mail) come from the application's settings.
EnvironmentFile=/etc/pokeprice/pokeprice.env
ExecStart=/opt/pokeprice/.venv/bin/python -m pokeprice.manage --data /srv/pokeprice/inventory brief --notify
UMask=0077
Nice=10
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/pokeprice/inventory
