[Unit]
Description=Poképrice - vérification quotidienne de la clé de l'agent des lots

[Timer]
# Daily check; a new key is issued 48 h before expiry, so a missed day or two
# still leaves a valid key. Before the rotation (10:00).
OnCalendar=*-*-* 09:30:00 Europe/Paris
RandomizedDelaySec=15min
Persistent=true
Unit=pokeprice-lots-key.service

[Install]
WantedBy=timers.target
