[Unit]
Description=Effacement des empreintes d’audience des jours précédents

[Service]
Type=oneshot
User=pokeprice
Group=pokeprice
WorkingDirectory=/opt/pokeprice
Environment=TZ=Europe/Paris
ExecStart=/opt/pokeprice/.venv/bin/python -m pokeprice.manage --data /srv/pokeprice/inventory audience-purge
UMask=0077
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/pokeprice
